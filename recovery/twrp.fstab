/recovery        emmc   /dev/block/platform/sdhci-tegra.3/by-name/SOS
/boot            emmc   /dev/block/platform/sdhci-tegra.3/by-name/LNX
/system          ext4   /dev/block/platform/sdhci-tegra.3/by-name/APP
/data            ext4   /dev/block/platform/sdhci-tegra.3/by-name/UDA          flags=encryptable=/dev/block/platform/sdhci-tegra.3/by-name/MDA
/cache           ext4   /dev/block/platform/sdhci-tegra.3/by-name/CAC
/persist         ext4   /dev/block/platform/sdhci-tegra.3/by-name/PST          flags=display="Persist Data";wipeingui;backup=1
/misc            emmc   /dev/block/platform/sdhci-tegra.3/by-name/MDA          flags=display="Dualboot Mark";backup=1
/staging         emmc   /dev/block/platform/sdhci-tegra.3/by-name/USP
/metadata        emmc   /dev/block/platform/sdhci-tegra.3/by-name/MDA          flags=display="Encrypt Table";backup=1

/usbdrive        vfat   /dev/block/sda1         /dev/block/sda                  flags=display="USB Drive";storage;wipeingui;removable
