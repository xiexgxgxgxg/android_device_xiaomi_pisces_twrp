#!/sbin/sh
OUTFD=$2
ui_print() {
  echo -n -e "ui_print $1\n" > /proc/self/fd/$OUTFD
  echo -n -e "ui_print\n" > /proc/self/fd/$OUTFD
}
abort_() { ui_print "ABORT: $1"; exit 1; }

ui_print "=== pisces: format system/cache after repartition ==="
[ "$(getprop ro.product.device)" = "pisces" ] || abort_ "wrong device"
umount -l /system 2>/dev/null; umount -l /cache 2>/dev/null
S24=$(cat /sys/class/block/mmcblk0p24/size 2>/dev/null)
S26=$(cat /sys/class/block/mmcblk0p26/size 2>/dev/null)
ui_print "p24=$S24 sectors  p26=$S26 sectors"
[ "$S24" = "8388608" ] || abort_ "system is not 4 GiB yet, flash the repartition zip first"
ui_print "formatting system (ext4) ..."
mke2fs -t ext4 -b 4096 -L system /dev/block/mmcblk0p24 || abort_ "system format failed"
ui_print "formatting cache (ext4) ..."
mke2fs -t ext4 -b 4096 -L cache /dev/block/mmcblk0p26 || abort_ "cache format failed"
ui_print "done. now use Wipe -> Format Data for userdata."
exit 0
