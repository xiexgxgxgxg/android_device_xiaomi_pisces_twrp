diff --git a/core/Makefile b/core/Makefile
index 51c3bf1..07f688e 100644
--- a/core/Makefile
+++ b/core/Makefile
@@ -2242,7 +2242,7 @@ $(INTERNAL_RECOVERY_RAMDISK_FILES_TIMESTAMP): $(MKBOOTFS) \
 	mkdir -p $(TARGET_RECOVERY_ROOT_OUT)/sdcard $(TARGET_RECOVERY_ROOT_OUT)/tmp
 	# Copying baseline ramdisk...
 	# Use rsync because "cp -Rf" fails to overwrite broken symlinks on Mac.
-	rsync -a --exclude=sdcard $(IGNORE_RECOVERY_SEPOLICY) $(IGNORE_CACHE_LINK) $(TARGET_ROOT_OUT) $(TARGET_RECOVERY_OUT)
+	rsync -a --exclude=sdcard --exclude=/root/vendor $(IGNORE_RECOVERY_SEPOLICY) $(IGNORE_CACHE_LINK) $(TARGET_ROOT_OUT) $(TARGET_RECOVERY_OUT)
 	# Modifying ramdisk contents...
 	$(if $(filter true,$(BOARD_BUILD_SYSTEM_ROOT_IMAGE)),, \
 	  ln -sf /system/bin/init $(TARGET_RECOVERY_ROOT_OUT)/init)
@@ -2261,6 +2261,12 @@ $(INTERNAL_RECOVERY_RAMDISK_FILES_TIMESTAMP): $(MKBOOTFS) \
 	  cp -rf $(item) $(TARGET_RECOVERY_ROOT_OUT)/$(newline))
 	$(foreach item,$(recovery_fstab), \
 	  cp -f $(item) $(TARGET_RECOVERY_ROOT_OUT)/system/etc/recovery.fstab)
+	# EXCLUDE_UNUSED_FROM_RECOVERY: pisces recovery image must fit 16 MiB
+	rm -rf $(TARGET_RECOVERY_ROOT_OUT)/twres/languages
+	rm -f $(TARGET_RECOVERY_ROOT_OUT)/system/lib/libandroidicu.so $(TARGET_RECOVERY_ROOT_OUT)/system/lib/libicuuc.so $(TARGET_RECOVERY_ROOT_OUT)/system/lib/libicui18n.so
+	rm -f $(TARGET_RECOVERY_ROOT_OUT)/system/lib/libssh.so $(TARGET_RECOVERY_ROOT_OUT)/system/lib/libclang_rt.ubsan_standalone-arm-android.so $(TARGET_RECOVERY_ROOT_OUT)/system/lib/libchrome.so
+	rm -f $(TARGET_RECOVERY_ROOT_OUT)/system/bin/keystore_cli_v2
+	rm -f $(TARGET_RECOVERY_ROOT_OUT)/file_contexts.bin
 	$(if $(strip $(recovery_wipe)), \
 	  cp -f $(recovery_wipe) $(TARGET_RECOVERY_ROOT_OUT)/system/etc/recovery.wipe)
 	ln -sf prop.default $(TARGET_RECOVERY_ROOT_OUT)/default.prop
